# Run scripts/setup.ps1 to generate ignored local credentials.
APP_ENV=development
AUTH_MODE=development
DEV_AUTH_TOKEN=
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supply a private bucket and server credential when STORAGE_BACKEND=supabase.
STORAGE_BACKEND=local
PRIVATE_STORAGE_ROOT=.local/private-storage
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
MAX_UPLOAD_BYTES=26214400
AI_EXTERNAL_PROCESSING_ALLOWED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_ANALYSIS_MODEL=
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_LIMIT=8
RETRIEVAL_THRESHOLD=0.35
# Upload and analysis requests allowed per firm and user in each window.
UPLOAD_RATE_LIMIT=10
ANALYSIS_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60
IMAGE_PROVIDER=disabled
DIFFUSION_MODEL_ID=
# Set these in apps/web/.env.local for Supabase mode.
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
